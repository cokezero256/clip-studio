# Clip Studio — shared by the worker and the web app. Copy to `.env` and fill in.
APIFY_API_TOKEN=            # Instagram scraping for the outlier gallery
ANTHROPIC_API_KEY=          # titles, grounding, pane detection (primary vision model)
GEMINI_API_KEY=             # fallback vision/LLM provider
CLIPSTUDIO_DB=data/clipstudio.db

# Outlier corpus settings
OUTLIER_WINDOW_DAYS=90
OUTLIER_VISION_MODEL=
